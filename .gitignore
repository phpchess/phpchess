# Dependencies: installed by Composer in development, bundled only into release zips (A17)
/vendor/
/node_modules/
/tools/composer.phar

# Install-specific and generated files: never committed
/config/config.php
/config/secret.key
/storage/*
!/storage/.htaccess
!/storage/logs/
/storage/logs/*
!/storage/logs/.gitkeep
/var/
/build/
.phpunit.cache/
.phpunit.result.cache

