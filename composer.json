{
    "name": "phpchess/phpchess",
    "description": "phpChess 6 - correspondence and timed chess server for shared hosting and schools",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": { "PhpChess\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "PhpChess\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false,
        "audit": { "abandoned": "fail" }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
